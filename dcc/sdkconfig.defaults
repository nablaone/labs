# ESP32-C3 Super Mini: console over the chip's native USB-Serial/JTAG
# (the board's only USB port -- there's no USB-UART bridge chip).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# ESP32-C3FH4: 4MB flash embedded in the chip package.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# BLE link to the web page (main/ble_link.c): NimBLE host, peripheral
# role only, one client at a time.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y

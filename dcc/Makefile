IMAGE ?= dcc-esp32-idf-dev
IDF_TARGET ?= esp32c3
APP_DIR := $(CURDIR)
BUILD_DIR := build

.PHONY: image build monitor shell flash clean web

image:
	docker build -t $(IMAGE) .

build: image
	docker run --rm -v $(APP_DIR):/app -w /app $(IMAGE) \
		idf.py set-target $(IDF_TARGET) build

# ESP32 flashes over plain USB-serial via esptool -- no debug probe, and
# works fine straight from a native esptool install on the Mac, no
# Docker/Linux-box USB-passthrough detour needed. Not run through the
# container for that reason.
# Binary name varies by install method: pip's esptool package provides both
# `esptool` and `esptool.py`, but Debian's apt package only provides
# `esptool` -- pick whichever exists.
ESPTOOL := $(shell command -v esptool.py 2>/dev/null || command -v esptool 2>/dev/null || echo esptool.py)
# --no-stub: talk straight to the ROM bootloader instead of uploading
# esptool's stub flasher first -- slower, but works regardless of install
# method (Debian's +dfsg esptool package strips the prebuilt stub blobs).
# PORT auto-detects the ESP32-C3's native USB-Serial/JTAG device (a USB
# CDC-ACM port, no bridge chip): cu.usbmodem* on macOS, ttyACM* on Linux.
# Override with PORT=/dev/whatever if you ever have more than one attached.
PORT ?= $(shell ls /dev/cu.usbmodem* /dev/ttyACM* 2>/dev/null | head -1)
# build/flash_args is generated by `idf.py build` -- the exact
# offset:binary pairs plus flash-mode/freq/size flags esptool needs, so
# this Makefile doesn't have to hardcode any of that.
flash: build
	$(if $(PORT),,$(error No PORT found -- is the ESP32 plugged in? Or pass PORT=/dev/cu.usbmodemXXXX))
	cd $(BUILD_DIR) && $(ESPTOOL) --chip $(IDF_TARGET) --no-stub -p $(PORT) write_flash $$(cat flash_args)

# Watch the console. Native on the host like flash. Ctrl-A X to exit.
# The baud rate is ignored by USB CDC; any value works.
# minicom's default hardware/software flow control is a well-known cause of
# "I don't see what I type" on ESP32 boards -- minicom withholds display
# waiting on flow-control signals the board never asserts. Fixed by
# generating a minimal per-user minicom profile (~/.minirc.dcc-esp32-idf)
# with both off, idempotent (only written if missing) rather than
# touching the user's default minirc.dfl.
MINIRC := $(HOME)/.minirc.dcc-esp32-idf
monitor:
	$(if $(PORT),,$(error No PORT found -- is the ESP32 plugged in? Or pass PORT=/dev/cu.usbmodemXXXX))
	@test -f $(MINIRC) || printf 'pu rtscts           No\npu xonxoff          No\n' > $(MINIRC)
	minicom -D $(PORT) -b 115200 dcc-esp32-idf

shell: image
	docker run --rm -it -v $(APP_DIR):/app -w /app $(IMAGE) bash

# Web Bluetooth viewer (web/index.html). Web Bluetooth only works in a
# secure context, which localhost counts as -- open http://localhost:8000
# in Chrome or Edge. Bound to 127.0.0.1 so it isn't exposed on the LAN.
web:
	python3 -m http.server 8000 --bind 127.0.0.1 --directory web

clean:
	rm -rf $(BUILD_DIR) sdkconfig sdkconfig.old

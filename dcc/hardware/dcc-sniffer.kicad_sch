	)
	(text
		"LED1 is anti-parallel to the 6N137 input LED (limits its reverse voltage, 5 V max)\nand lights as a 'DCC present' indicator. R1 sets ~10 mA at 15-18 V track voltage.\nOutput is open-drain: low while the input LED conducts. R2 pulls up to 3V3, not 5 V.\nC3: 100n ceramic, right at U1 pins 8-5."
		(exclude_from_sim no)
		(at 45.72 95.25 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ef82d438-bc1a-483f-8b9a-5ddb8aedf3c8")
	)

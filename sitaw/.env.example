# Address people open in the browser (used in invite links and agent prompts).
SITAW_BASE_URL=https://sitaw.example.lan
# Secret for /api/admin (teams, invites, removing members). Generate one:
#   openssl rand -hex 24
SITAW_ADMIN_TOKEN=change-me
# Host port to publish (container listens on 8080).
SITAW_PORT=8080
# Host directory for the database (sitaw.db). Create it before the first start.
SITAW_DATA_DIR=./data
# User the container runs as; must be able to write SITAW_DATA_DIR. Use yours:
#   echo "SITAW_UID=$(id -u)" "SITAW_GID=$(id -g)"
SITAW_UID=1000
SITAW_GID=1000

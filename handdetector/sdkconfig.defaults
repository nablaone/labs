# DFRobot FireBeetle 2 ESP32-S3-U (DFR0975-U): ESP32-S3-WROOM-1U-N16R8.
# Identified with `esptool chip-id`/`flash-id`: ESP32-S3 (QFN56) rev v0.1,
# 8 MB embedded PSRAM, 16 MB quad flash.

# Console over the S3's native USB-Serial/JTAG (the board's USB-C port --
# no USB-UART bridge chip).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
# Custom partition table: 3 MB app + 4 MB "model" data partition holding
# the .tflite (memory-mapped by main/detector.cc).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# The "R8" part: 8 MB octal (OPI) PSRAM inside the module. Camera frame
# buffers go here.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# 1 kHz tick: the BLE sender waits on notify-complete events with short
# timeouts; at the default 100 Hz the shortest wait is 10 ms.
CONFIG_FREERTOS_HZ=1000

# BLE diagnostic link to web/index.html (main/ble_link.c): NimBLE host,
# peripheral role only, one client at a time. Big ATT MTU and more mbufs
# for streaming camera frames.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=512
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=32

# Core 1 runs the detector, which keeps it busy for seconds per inference
# by design. Don't have the task watchdog expect core 1's idle task to run;
# core 0 (BLE, console) stays watched.
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n

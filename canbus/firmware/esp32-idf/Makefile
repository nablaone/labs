IMAGE ?= canbus-esp32-idf-dev
IDF_TARGET ?= esp32
APP_DIR := $(CURDIR)
BUILD_DIR := build

.PHONY: image build monitor shell flash clean can-sniff can-send

image:
	docker build -t $(IMAGE) .

build: image
	docker run --rm -v $(APP_DIR):/app -w /app $(IMAGE) \
		idf.py set-target $(IDF_TARGET) build

# ESP32 flashes over plain USB-serial via esptool -- no debug probe, and
# (unlike SWD probes) works fine straight from a native esptool install on
# the Mac, no Docker/Linux-box USB-passthrough detour needed (see
# ../../CLAUDE.md). Not run through the container for that reason.
# Binary name varies by install method: pip's esptool package provides both
# `esptool` and `esptool.py`, but Debian's apt package only provides
# `esptool` -- pick whichever exists.
ESPTOOL := $(shell command -v esptool.py 2>/dev/null || command -v esptool 2>/dev/null || echo esptool.py)
# --no-stub: talk straight to the ROM bootloader instead of uploading
# esptool's stub flasher first -- slower, but works regardless of install
# method (Debian's +dfsg esptool package strips the prebuilt stub blobs,
# see the same fix in ../zephyr-canbus/Makefile).
# PORT auto-detects the DevKit's CP2102 USB-serial device. Covers both
# macOS naming (cu.usbserial-XXXX, or cu.SLAB_USBtoUART* if the Silicon
# Labs driver is installed instead of the CDC-ACM one) and Linux naming
# (ttyUSB*). Override with PORT=/dev/whatever if you ever have more than
# one attached.
PORT ?= $(shell ls /dev/cu.usbserial-* /dev/cu.SLAB_USBtoUART* /dev/ttyUSB* 2>/dev/null | head -1)
# build/flash_args is generated by `idf.py build` -- the exact
# offset:binary pairs plus flash-mode/freq/size flags esptool needs, so
# this Makefile doesn't have to hardcode any of that.
flash: build
	$(if $(PORT),,$(error No PORT found -- is the ESP32 plugged in? Or pass PORT=/dev/tty.usbserial-XXXX))
	cd $(BUILD_DIR) && $(ESPTOOL) --chip esp32 --no-stub -p $(PORT) write_flash $$(cat flash_args)

# Watch the ESP32's serial console (115200 8N1, ESP-IDF's default). Native
# on the host like flash, same macOS/Linux-passthrough reasoning. Ctrl-A X
# to exit.
# minicom's default hardware/software flow control is a well-known cause of
# "I don't see what I type" on ESP32 boards -- the board doesn't wire real
# UART flow control at all, so minicom just withholds display waiting on
# it. Fixed by generating a minimal per-user minicom profile
# (~/.minirc.canbus-esp32-idf) with both off, idempotent (only written if
# missing) rather than touching the user's default minirc.dfl.
MINIRC := $(HOME)/.minirc.canbus-esp32-idf
monitor:
	$(if $(PORT),,$(error No PORT found -- is the ESP32 plugged in? Or pass PORT=/dev/tty.usbserial-XXXX))
	@test -f $(MINIRC) || printf 'pu rtscts           No\npu xonxoff          No\n' > $(MINIRC)
	minicom -D $(PORT) -b 115200 canbus-esp32-idf

shell: image
	docker run --rm -it -v $(APP_DIR):/app -w /app $(IMAGE) bash

# Mac-side CAN sniff/send via cantool.py, talking directly to a CANable-
# style dongle's slcan serial port (python-can) -- no SocketCAN needed, so
# this works natively on macOS. Linux/SocketCAN skipped on purpose: that
# path already has the real thing (candump/cansend), see
# ../../scripts/setup-socketcan.sh. Same <id_hex>#<data_hex> frame syntax
# as the ESP32's own "can sniff"/"can send" CLI commands.
# Own venv (not the host Python) since macOS's Homebrew Python refuses
# unmanaged `pip install` (PEP 668) -- created once, reused after.
CANTOOL := $(CURDIR)/cantool.py
CANVENV := $(CURDIR)/.cantool-venv
CANPY := $(CANVENV)/bin/python3

$(CANPY):
	python3 -m venv $(CANVENV)
	$(CANPY) -m pip install -q python-can pyserial

can-sniff: $(CANPY)
	$(CANPY) $(CANTOOL) sniff

# make can-send FRAME=123#DEADBEEF
can-send: $(CANPY)
	$(if $(FRAME),,$(error Pass FRAME=<id_hex>#<data_hex>, e.g. make can-send FRAME=123#DEADBEEF))
	$(CANPY) $(CANTOOL) send $(FRAME)

clean:
	rm -rf $(BUILD_DIR) sdkconfig sdkconfig.old
